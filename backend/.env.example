# --- Database ---
# Default: local SQLite, zero setup, works out of the box.
DATABASE_URL=sqlite:///./skilllens.db

# To use Supabase instead: Supabase project -> Settings -> Database ->
# Connection string -> URI (use the "Transaction pooler" string), e.g.
# DATABASE_URL=postgresql+psycopg2://postgres:<password>@<project-ref>.supabase.co:5432/postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- Auth ---
# Required: Secret key for signing JWT tokens. Application will fail to start if not set.
JWT_SECRET=

# Firebase Project ID for server-side public-key ID token verification
FIREBASE_PROJECT_ID=skilllenss

# --- LLM (needed for quiz generation) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
